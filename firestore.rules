rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.email is string && data.email.size() <= 200
        && data.name is string && data.name.size() <= 100
        && data.role == 'Pathologist' 
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['authorId', 'patientName', 'age', 'gender', 'hospitalNumber', 'reportNumber', 'status', 'createdAt', 'updatedAt'])
        && data.authorId == request.auth.uid
        && data.patientName is string && data.patientName.size() <= 200
        && data.age is int && data.age >= 0 && data.age <= 150
        && data.gender in ['Male', 'Female', 'Other']
        && data.hospitalNumber is string && data.hospitalNumber.size() <= 50
        && data.reportNumber is string && data.reportNumber.size() <= 64
        && data.status == 'Pending'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['authorId', 'name', 'isPublic', 'createdAt', 'updatedAt'])
        && data.authorId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.isPublic is bool
        && (data.get('content', '') is string && data.get('content', '').size() <= 50000)
        && (data.get('clinicalHistory', '') is string && data.get('clinicalHistory', '').size() <= 50000)
        && (data.get('grossFindings', '') is string && data.get('grossFindings', '').size() <= 50000)
        && (data.get('microscopicFindings', '') is string && data.get('microscopicFindings', '').size() <= 50000)
        && (data.get('ihcAdvice', '') is string && data.get('ihcAdvice', '').size() <= 50000)
        && (data.get('finalDiagnosis', '') is string && data.get('finalDiagnosis', '').size() <= 50000)
        && (data.get('organSystem', '') is string && data.get('organSystem', '').size() <= 100)
        && (data.get('clinicalKeywords', '') is string && data.get('clinicalKeywords', '').size() <= 500)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Match Blocks
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if (
        isSignedIn() && request.auth.uid == userId && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          && incoming().name is string && incoming().name.size() <= 100
          && incoming().updatedAt == request.time
        )
      ) || isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(reportId) && isValidReport(incoming());
      allow update: if (
        isSignedIn() && isValidId(reportId) && (
          (existing().authorId == request.auth.uid && existing().status == 'Pending' && (
            (incoming().diff(existing()).affectedKeys().hasOnly([
              'patientName', 'age', 'gender', 'hospitalNumber', 'reportNumber', 
              'referringDoctor', 'dateOfProcedure', 'dateOfReport', 'specimenReceivedDate', 
              'organSystem', 'clinicalHistory', 'grossFindings', 'microscopicFindings', 
              'ihcAdvice', 'finalDiagnosis', 'comments', 'status', 'updatedAt'
            ]) && incoming().status in ['Pending', 'Finalized'] && incoming().updatedAt == request.time)
          ))
          || (existing().authorId == request.auth.uid && existing().status == 'Finalized' && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status == 'Archived'
            && incoming().updatedAt == request.time
          ))
          || isAdmin()
        )
      );
      allow delete: if isAdmin();
    }

    match /templates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId) && (existing().authorId == request.auth.uid || existing().isPublic == true);
      allow list: if isSignedIn() && (resource.data.isPublic == true || resource.data.authorId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(templateId) && isValidTemplate(incoming());
      allow update: if isSignedIn() && isValidId(templateId) && (
        (existing().authorId == request.auth.uid && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'content', 'isPublic', 'organSystem', 'clinicalKeywords', 'clinicalHistory', 'grossFindings', 'microscopicFindings', 'ihcAdvice', 'finalDiagnosis', 'updatedAt'])
          && incoming().updatedAt == request.time
        )) || isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(templateId) && (existing().authorId == request.auth.uid || isAdmin());
    }
    
    match /admins/{adminId} {
       allow read: if isSignedIn() && request.auth.uid == adminId;
    }
  }
}

